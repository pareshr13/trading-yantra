---
import { locales, localeLabels, type Locale } from '../i18n/config';
import { localizedPath } from '../i18n/url';

interface Props {
  lang: Locale;
  /** Current page's path with no locale prefix, e.g. '/', '/product'. */
  path: string;
  class?: string;
}

const { lang, path, class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-1 ${className}`} role="group" aria-label="Language">
  {locales.map((locale) => (
    <a
      href={localizedPath(locale, path)}
      class={`rounded-md px-2 py-1 text-xs font-bold transition-colors ${
        locale === lang ? 'bg-white/10 text-white' : 'text-slate-400 hover:text-white hover:bg-white/5'
      }`}
      aria-current={locale === lang ? 'true' : undefined}
      lang={locale}
    >
      {localeLabels[locale]}
    </a>
  ))}
</div>
