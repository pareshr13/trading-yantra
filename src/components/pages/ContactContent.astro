---
import ContactForm from '../ContactForm.astro';
import type { Locale } from '../../i18n/config';
import type { Dictionary } from '../../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const c = t.contact;
const whatsappNumber = '918460771378';
const whatsappHref = `https://wa.me/${whatsappNumber}`;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[380px] bg-radial-fade"></div>
  <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
      {c.pill}
    </p>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
      {c.headlinePlain} <span class="text-gradient-brand">{c.headlineHighlight}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
      {c.subcopy}
    </p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_1.4fr]">
    <div class="space-y-6">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl border-2 border-emerald-500/40 bg-emerald-500/10 p-6 transition-colors hover:border-emerald-400/60"
      >
        <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-emerald-300">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7-1.87-1.87-4.36-2.9-7-2.9zm0 18.1h-.01a8.2 8.2 0 01-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 012.41 5.83c0 4.55-3.7 8.24-8.25 8.24zm4.52-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.02 2.58.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.1-.23-.16-.48-.28z"/></svg>
          {c.whatsappLabel}
        </h2>
        <p class="mt-3 text-lg font-bold text-white">{c.whatsappCta}</p>
        <p class="mt-2 text-sm text-emerald-200/80">{c.whatsappNote}</p>
      </a>

      <div class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400">{c.emailLabel}</h2>
        <a href="mailto:aitradingyantra@gmail.com" class="mt-3 block text-lg font-bold text-teal-300 hover:text-teal-200">
          aitradingyantra@gmail.com
        </a>
        <p class="mt-2 text-sm text-slate-400">{c.emailNote}</p>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400">{c.phoneLabel}</h2>
        <a href="tel:+918460771378" class="mt-3 block text-lg font-bold text-teal-300 hover:text-teal-200">
          +91 84607 71378
        </a>
        <p class="mt-2 text-sm text-slate-400">{c.phoneNote}</p>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400">{c.responseLabel}</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-300">
          {c.responseBody}
        </p>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400">{c.beforeLabel}</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-300">
          {c.beforeBody}
        </p>
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <ContactForm lang={lang} t={t} />
    </div>
  </div>
</section>
