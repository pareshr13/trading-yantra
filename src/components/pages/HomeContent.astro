---
import CandlestickHero from '../CandlestickHero.astro';
import FeatureCard from '../FeatureCard.astro';
import StatCounter from '../StatCounter.astro';
import CtaBanner from '../CtaBanner.astro';
import { localizedPath } from '../../i18n/url';
import type { Locale } from '../../i18n/config';
import type { Dictionary } from '../../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const h = t.home;
---

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-radial-fade"></div>
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:px-8 lg:py-28">
    <div>
      <p class="fade-in-up inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
        <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
        {h.pill}
      </p>
      <h1 class="fade-in-up mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.25rem] lg:leading-[1.15]" style="animation-delay:0.05s">
        {h.headlinePlain} <span class="text-gradient-brand">{h.headlineHighlight}</span>{h.headlineEnd}
      </h1>
      <p class="fade-in-up mt-6 max-w-xl text-lg leading-relaxed text-slate-300" style="animation-delay:0.1s">
        {h.subcopy}
      </p>
      <div class="fade-in-up mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:0.15s">
        <a href={localizedPath(lang, '/contact')} class="inline-flex items-center justify-center rounded-lg bg-gradient-brand px-7 py-4 text-base font-bold text-ink shadow-lg shadow-teal-500/10 transition-transform hover:scale-[1.02]">
          {h.ctaPrimary}
        </a>
        <a href={localizedPath(lang, '/product')} class="inline-flex items-center justify-center rounded-lg border border-line px-7 py-4 text-base font-bold text-slate-200 transition-colors hover:border-teal-500/40 hover:text-white">
          {h.ctaSecondary}
        </a>
      </div>
      <p class="fade-in-up mt-5 text-sm text-slate-400" style="animation-delay:0.2s">
        {h.disclaimerNote}{' '}
        <a href={localizedPath('en', '/disclaimer')} class="underline hover:text-slate-300">{h.disclaimerLinkText}</a>.
      </p>
    </div>

    <div class="fade-in-up" style="animation-delay:0.1s">
      <CandlestickHero t={t} />
    </div>
  </div>
</section>

<!-- Trust strip -->
<section class="border-y border-line bg-ink-soft">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
      {h.trustStrip.map((s) => (
        <div>
          <p class="font-mono text-2xl font-extrabold text-white">{s.value}</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-400">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Feature highlights -->
<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{h.featuresHeading}</h2>
    <p class="mt-4 text-lg text-slate-300">{h.featuresSubcopy}</p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {h.features.map((feature, i) => (
      <FeatureCard
        lang={lang}
        icon={feature.icon}
        title={feature.title}
        description={feature.description}
        href={['/product#ai-signals', '/product#indicators', '/product#candlestick', '/product#patterns'][i]}
      />
    ))}
  </div>
</section>

<!-- How it works -->
<section class="border-y border-line bg-ink-soft">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{h.howHeading}</h2>
      <p class="mt-4 text-lg text-slate-300">{h.howSubcopy}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3">
      {h.howSteps.map((s) => (
        <div class="relative">
          <span class="font-mono text-5xl font-black text-white/10">{s.step}</span>
          <h3 class="mt-2 text-xl font-bold text-white">{s.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-slate-300">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Honesty / differentiation -->
<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {h.honestyHeading} <span class="text-gradient-brand">{h.honestyHighlight}</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-300">
        {h.honestyBody}
      </p>
      <ul class="mt-8 space-y-4">
        {h.honestyPoints.map((point) => (
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 flex-none text-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-base text-slate-300">{point}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl border border-line bg-surface p-8">
      <p class="font-mono text-xs uppercase tracking-widest text-slate-400">{h.statsLabel}</p>
      <div class="mt-8 grid grid-cols-3 gap-6">
        {h.stats.map((s) => (
          <StatCounter value={Number(s.value)} label={s.label} />
        ))}
      </div>
      <p class="mt-8 text-sm leading-relaxed text-slate-400">
        {h.statsNote}{' '}
        <a href={localizedPath('en', '/disclaimer')} class="underline hover:text-slate-300">{h.statsLinkText}</a>.
      </p>
    </div>
  </div>
</section>

<CtaBanner
  lang={lang}
  title={h.ctaBannerTitle}
  description={h.ctaBannerBody}
  primaryLabel={h.ctaPrimary}
  secondaryLabel={h.ctaSecondary}
/>
