---
import CtaBanner from '../CtaBanner.astro';
import ProductShot from '../ProductShot.astro';
import backtestResult from '../../assets/screens/backtest-result.png';
import swingEvidence from '../../assets/screens/swing-evidence.png';
import riskList from '../../assets/screens/risk-list.png';
import candlestickResearch from '../../assets/screens/candlestick-research.png';
import strategyBuilder from '../../assets/screens/strategy-builder.png';
import askTradingYantra from '../../assets/screens/ask-trading-yantra.png';
import structureParticipation from '../../assets/screens/structure-participation.png';
import { localizedPath } from '../../i18n/url';
import type { Locale } from '../../i18n/config';
import type { Dictionary } from '../../i18n/dictionaries';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const p = t.product;

// Sections backed by a real app screen show it instead of the illustrative
// metric card. Keyed by section id so translated dictionaries need no change.
const shots: Record<string, { src: ImageMetadata; label: string }> = {
  evidence: { src: swingEvidence, label: 'Swing Trading' },
  backtest: { src: backtestResult, label: 'Backtest Your Rule' },
  'risk-list': { src: riskList, label: 'Risk List' },
  candlestick: { src: candlestickResearch, label: 'Candlestick Research' },
  'strategy-builder': { src: strategyBuilder, label: 'Strategy Builder' },
  ask: { src: askTradingYantra, label: 'Ask the Trading Yantra' },
  structure: { src: structureParticipation, label: 'Structure + Participation' },
};

// Illustrative example alerts on the watchlist section — descriptive
// technical events (not buy/sell calls), and labels stay in English/ticker
// style since that's how they'd render in the real product regardless of UI
// language.
const watchlistExamples = [
  { tag: 'ABOVE 50-DMA', symbol: 'HDFCBANK' },
  { tag: 'RSI OVERSOLD', symbol: 'TCS' },
  { tag: 'VOLUME SPIKE', symbol: 'ZOMATO' },
];

const shotSections = p.sections.filter((s) => shots[s.id]);
const textSections = p.sections.filter((s) => !shots[s.id]);
const signupHref = localizedPath(lang, '/') + '#signup';
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-radial-fade"></div>
  <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24 lg:px-8">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-accent">
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
      {p.pill}
    </p>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-fg sm:text-5xl">
      {p.headlinePlain} <span class="text-gradient-brand">{p.headlineHighlight}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-fg-soft">
      {p.subcopy}
    </p>
  </div>
</section>

{shotSections.map((s, i) => (
  <section id={s.id} class={`border-b border-line ${i % 2 === 1 ? 'bg-ink-soft' : ''}`}>
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class={`grid grid-cols-1 items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-accent">{s.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">{s.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-fg-soft">{s.body}</p>
          <ul class="mt-6 space-y-3">
            {s.bullets.map((b) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-none text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-base text-fg-soft">{b}</span>
              </li>
            ))}
          </ul>
          <a href={signupHref} data-signup-link class="mt-8 inline-flex items-center gap-2 rounded-lg bg-gradient-brand px-5 py-3 text-sm font-bold text-on-brand transition-transform hover:scale-[1.02]">
            {t.nav.cta} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ProductShot src={shots[s.id].src} alt={s.title} label={shots[s.id].label} caption={t.common.screenshotCaption} glow />
      </div>
    </div>
  </section>
))}

<!-- Sections without a product screen: compact cards, no placeholder art -->
<section class="border-b border-line">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-16 sm:px-6 md:grid-cols-2 lg:px-8 lg:py-20">
    {textSections.map((s) => (
      <div id={s.id} class="scroll-mt-28 rounded-2xl border border-line bg-surface p-6 sm:p-7">
        <p class="text-xs font-bold uppercase tracking-widest text-accent">{s.eyebrow}</p>
        <h2 class="mt-3 text-xl font-extrabold tracking-tight text-fg sm:text-2xl">{s.title}</h2>
        <p class="mt-3 text-base leading-relaxed text-fg-soft">{s.body}</p>
        <ul class="mt-5 space-y-2.5">
          {s.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm text-fg-soft">
              <svg class="mt-0.5 h-4 w-4 flex-none text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              {b}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<!-- Watchlist & alerts -->
<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-accent">{p.watchlistEyebrow}</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">{p.watchlistTitle}</h2>
      <p class="mt-5 text-lg leading-relaxed text-fg-soft">
        {p.watchlistBody}
      </p>
    </div>
    <div class="space-y-3">
      {watchlistExamples.map((a) => (
        <div class="flex items-center justify-between rounded-xl border border-line bg-surface px-4 py-3.5">
          <div class="flex items-center gap-3">
            <span class="rounded bg-teal-950 light:bg-teal-50 px-2 py-1 text-[10px] font-extrabold uppercase text-accent">{a.tag}</span>
            <span class="font-mono text-sm font-bold text-fg">{a.symbol}</span>
          </div>
        </div>
      ))}
      <p class="pt-1 text-sm text-muted">{p.watchlistNote}</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="border-t border-line bg-ink-soft">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">{p.faqHeading}</h2>
    <div class="mt-12 space-y-3">
      {p.faqs.map((f) => (
        <details class="group rounded-xl border border-line bg-surface px-5 py-4 open:border-teal-500/30">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-bold text-fg">
            {f.q}
            <svg class="h-5 w-5 flex-none text-muted transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-fg-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBanner
  lang={lang}
  t={t}
  title={p.ctaTitle}
  description={p.ctaBody}
  secondaryLabel={t.nav.contact}
  secondaryHref={localizedPath(lang, '/contact')}
  source="product-cta"
/>
