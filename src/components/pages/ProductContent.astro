---
import CtaBanner from '../CtaBanner.astro';
import { localizedPath } from '../../i18n/url';
import type { Locale } from '../../i18n/config';
import type { Dictionary } from '../../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const p = t.product;

// Illustrative example alerts on the watchlist section — labels only
// (BUY/SELL/TAKE_PROFIT tags) stay in English/ticker style since that's how
// they'd render in the real product regardless of UI language.
const watchlistExamples = [
  { tag: 'BUY', symbol: 'HDFCBANK' },
  { tag: 'TAKE_PROFIT', symbol: 'TCS' },
  { tag: 'SELL', symbol: 'ZOMATO' },
];
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-radial-fade"></div>
  <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24 lg:px-8">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
      <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
      {p.pill}
    </p>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
      {p.headlinePlain} <span class="text-gradient-brand">{p.headlineHighlight}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
      {p.subcopy}
    </p>
  </div>
</section>

{p.sections.map((s, i) => (
  <section id={s.id} class={`border-b border-line ${i % 2 === 1 ? 'bg-ink-soft' : ''}`}>
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class={`grid grid-cols-1 items-center gap-12 lg:grid-cols-2 ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-teal-400">{s.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{s.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">{s.body}</p>
          <ul class="mt-6 space-y-3">
            {s.bullets.map((b) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 flex-none text-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-base text-slate-300">{b}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-8">
          <div class="flex items-center justify-between border-b border-line-soft pb-4">
            <span class="font-mono text-xs uppercase tracking-widest text-slate-400">{s.metricLabel}</span>
            <span class="rounded-full bg-white/5 px-2.5 py-1 font-mono text-xs text-teal-300">{t.common.liveEngineBadge}</span>
          </div>
          <p class="mt-6 font-mono text-5xl font-extrabold text-gradient-brand">{s.metricValue}</p>
          <div class="mt-8 space-y-3">
            {[70, 45, 85].map((w) => (
              <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/5">
                <div class="h-full rounded-full bg-gradient-brand" style={`width:${w}%`}></div>
              </div>
            ))}
          </div>
          <p class="mt-6 text-sm text-slate-400">{t.common.illustrativeNote}</p>
        </div>
      </div>
    </div>
  </section>
))}

{p.comingSoon && (
  <section class={`border-b border-line ${p.sections.length % 2 === 1 ? 'bg-ink-soft' : ''}`}>
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-950 px-3 py-1 text-xs font-bold uppercase tracking-wide text-amber-300">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            {p.comingSoon.badge}
          </span>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{p.comingSoon.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">{p.comingSoon.body}</p>
          <a
            href={localizedPath('en', '/algo-trading')}
            class="mt-6 inline-flex items-center gap-1.5 rounded-lg border border-line px-6 py-3 text-sm font-bold text-slate-200 transition-colors hover:border-teal-500/40 hover:text-white"
          >
            {p.comingSoon.cta}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
        <div class="rounded-2xl border border-dashed border-line bg-surface p-8">
          <p class="font-mono text-xs uppercase tracking-widest text-slate-400">Planned integrations</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {['Zerodha', 'Upstox', 'Angel One', 'Fyers', 'Dhan'].map((broker) => (
              <span class="rounded-lg border border-line bg-ink-soft px-3 py-2 text-sm font-semibold text-slate-300">{broker}</span>
            ))}
          </div>
          <p class="mt-6 text-sm text-slate-400">Subject to each broker’s API access and approval — platform list may change before launch.</p>
        </div>
      </div>
    </div>
  </section>
)}

<!-- Watchlist & alerts -->
<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-teal-400">{p.watchlistEyebrow}</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{p.watchlistTitle}</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-300">
        {p.watchlistBody}
      </p>
    </div>
    <div class="space-y-3">
      {watchlistExamples.map((a) => (
        <div class="flex items-center justify-between rounded-xl border border-line bg-surface px-4 py-3.5">
          <div class="flex items-center gap-3">
            <span class={`rounded px-2 py-1 text-[10px] font-extrabold uppercase ${
              a.tag === 'BUY' ? 'bg-emerald-950 text-emerald-300' : a.tag === 'SELL' ? 'bg-rose-950 text-rose-300' : 'bg-amber-950 text-amber-300'
            }`}>{a.tag}</span>
            <span class="font-mono text-sm font-bold text-white">{a.symbol}</span>
          </div>
        </div>
      ))}
      <p class="pt-1 text-sm text-slate-400">{p.watchlistNote}</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="border-t border-line bg-ink-soft">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{p.faqHeading}</h2>
    <div class="mt-12 space-y-3">
      {p.faqs.map((f) => (
        <details class="group rounded-xl border border-line bg-surface px-5 py-4 open:border-teal-500/30">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-bold text-white">
            {f.q}
            <svg class="h-5 w-5 flex-none text-slate-400 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-slate-300">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBanner
  lang={lang}
  title={p.ctaTitle}
  description={p.ctaBody}
  primaryLabel={t.home.ctaPrimary}
  secondaryLabel={t.nav.contact}
  secondaryHref={localizedPath(lang, '/contact')}
/>
