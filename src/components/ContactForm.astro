---
// Static-site contact form using Web3Forms (https://web3forms.com) — a free,
// no-backend-required form relay: it accepts a plain POST from a static page
// and emails the submission, no server or signup flow required to try it.
import type { Dictionary } from '../i18n/dictionaries';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/url';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const f = t.contact;
const WEB3FORMS_ACCESS_KEY = '3e8bc03f-2b1f-4d46-8b80-5dd99982ce77';
---

<form
  id="contact-form"
  class="space-y-5"
  data-access-key={WEB3FORMS_ACCESS_KEY}
  data-success={f.formSuccess}
  data-error-not-configured={f.formErrorNotConfigured}
  data-error-generic={f.formErrorGeneric}
  data-sending-label={f.formSending}
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="New message from Trading Yantra website" />
  <input type="hidden" name="language" value={lang} />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="block text-sm font-semibold text-slate-300">{f.formNameLabel}</label>
      <input
        type="text" id="name" name="name" required autocomplete="name"
        class="mt-2 w-full rounded-lg border border-line bg-surface px-4 py-3 text-base text-white placeholder-slate-500 outline-none transition-colors focus:border-teal-400"
        placeholder={f.formNamePlaceholder}
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-semibold text-slate-300">{f.formEmailLabel}</label>
      <input
        type="email" id="email" name="email" required autocomplete="email"
        class="mt-2 w-full rounded-lg border border-line bg-surface px-4 py-3 text-base text-white placeholder-slate-500 outline-none transition-colors focus:border-teal-400"
        placeholder={f.formEmailPlaceholder}
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="phone" class="block text-sm font-semibold text-slate-300">{f.formPhoneLabel} <span class="text-slate-400 font-normal">{f.formPhoneOptional}</span></label>
      <input
        type="tel" id="phone" name="phone" autocomplete="tel"
        class="mt-2 w-full rounded-lg border border-line bg-surface px-4 py-3 text-base text-white placeholder-slate-500 outline-none transition-colors focus:border-teal-400"
        placeholder={f.formPhonePlaceholder}
      />
    </div>
    <div>
      <label for="topic" class="block text-sm font-semibold text-slate-300">{f.formTopicLabel}</label>
      <select
        id="topic" name="topic"
        class="mt-2 w-full rounded-lg border border-line bg-surface px-4 py-3 text-base text-white outline-none transition-colors focus:border-teal-400"
      >
        {f.formTopicOptions.map((opt) => <option>{opt}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-slate-300">{f.formMessageLabel}</label>
    <textarea
      id="message" name="message" required rows="5"
      class="mt-2 w-full resize-none rounded-lg border border-line bg-surface px-4 py-3 text-base text-white placeholder-slate-500 outline-none transition-colors focus:border-teal-400"
      placeholder={f.formMessagePlaceholder}
    ></textarea>
  </div>

  <p class="text-xs leading-relaxed text-slate-400">
    {f.formConsentNote}{' '}
    <a href={localizedPath('en', '/privacy-policy')} class="underline hover:text-slate-300">{f.formConsentLinkText}</a>.
  </p>

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-brand px-7 py-3.5 text-base font-bold text-ink transition-transform hover:scale-[1.01] disabled:opacity-60 sm:w-auto"
  >
    <span data-submit-label>{f.formSubmit}</span>
  </button>

  <p data-form-status role="status" class="text-sm font-medium"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = form?.querySelector('[data-form-status]') as HTMLElement | null;
  const submitLabel = form?.querySelector('[data-submit-label]') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !statusEl || !submitLabel) return;

    const accessKey = form.dataset.accessKey;
    if (!accessKey || accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
      statusEl.textContent = form.dataset.errorNotConfigured ?? 'Form not configured.';
      statusEl.className = 'text-sm font-medium text-amber-400';
      return;
    }

    const originalLabel = submitLabel.textContent;
    submitLabel.textContent = form.dataset.sendingLabel ?? 'Sending...';
    statusEl.textContent = '';

    try {
      const formData = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await res.json();

      if (result.success) {
        statusEl.textContent = form.dataset.success ?? 'Thanks!';
        statusEl.className = 'text-sm font-medium text-emerald-400';
        form.reset();
      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch (err) {
      statusEl.textContent = form.dataset.errorGeneric ?? 'Something went wrong.';
      statusEl.className = 'text-sm font-medium text-rose-400';
    } finally {
      submitLabel.textContent = originalLabel;
    }
  });
</script>
