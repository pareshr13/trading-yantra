---
interface Props {
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  primaryLabel = 'Get Early Access',
  primaryHref = '/contact',
  secondaryLabel = 'Explore the Product',
  secondaryHref = '/product',
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-3xl border border-line bg-surface px-6 py-14 text-center sm:px-16">
    <div class="pointer-events-none absolute inset-0 bg-radial-fade"></div>
    <div class="relative">
      <h2 class="mx-auto max-w-2xl text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-slate-400">{description}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={primaryHref}
          class="inline-flex w-full items-center justify-center rounded-lg bg-gradient-brand px-6 py-3 text-sm font-bold text-ink shadow-lg shadow-teal-500/10 transition-transform hover:scale-[1.02] sm:w-auto"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex w-full items-center justify-center rounded-lg border border-line px-6 py-3 text-sm font-bold text-slate-200 transition-colors hover:border-teal-500/40 hover:text-white sm:w-auto"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
