---
// Closing call to action on every main page: the headline plus the email
// signup (id="signup", the target of every "Start free" button).
import SignupForm from './SignupForm.astro';
import { localizedPath } from '../i18n/url';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
  title: string;
  description: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  source?: string;
}

const {
  lang,
  t,
  title,
  description,
  secondaryLabel,
  secondaryHref = localizedPath(lang, '/product'),
  source = 'cta-banner',
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="relative overflow-hidden rounded-3xl border border-line bg-surface px-5 py-12 text-center shadow-xl shadow-black/5 sm:px-12 sm:py-16">
    <div class="pointer-events-none absolute inset-0 bg-radial-fade"></div>
    <div class="pointer-events-none absolute inset-0 bg-chart-grid opacity-60"></div>
    <div class="relative">
      <h2 class="mx-auto max-w-2xl text-3xl font-extrabold tracking-tight text-fg sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-fg-soft">{description}</p>
      <div class="mt-8">
        <SignupForm lang={lang} t={t} id="signup" source={source} align="center" />
      </div>
      {secondaryLabel && (
        <a href={secondaryHref} class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition-colors hover:text-fg">
          {secondaryLabel} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</section>
