---
import { withBase } from '../utils/url';
import { localizedPath } from '../i18n/url';
import { locales, localeTags, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Bare path with no locale prefix, e.g. '/', '/product' — used to build hreflang alternates. */
  path: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
  /** False for English-only pages (legal, 404) that have no translated
   * counterpart at this path — skips emitting hreflang alternates that
   * would otherwise point at a 404. */
  hasTranslations?: boolean;
}

const {
  title,
  description,
  lang,
  path,
  image = withBase('/og-image.png'),
  noindex = false,
  jsonLd = [],
  hasTranslations = true,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://tradingyantra.com');
const canonicalURL = new URL(localizedPath(lang, path), siteUrl);
const ogImageURL = new URL(image, siteUrl);
const fullTitle = title.includes('Trading Yantra') ? title : `${title} | Trading Yantra`;
const ogLocale = localeTags[lang].replace('-', '_');

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Trading Yantra',
  url: siteUrl.toString(),
  logo: new URL(withBase('/logo/logo-512.png'), siteUrl).toString(),
  description:
    'Trading Yantra builds AI and machine-learning powered stock market analytics tools for NSE and BSE retail traders — technical indicators, candlestick and chart-pattern intelligence, and transparently backtested readings.',
  sameAs: [],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Trading Yantra',
  url: siteUrl.toString(),
};

const schemas = [orgSchema, siteSchema, ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Language alternates: this page's content exists in every locale at the
     same bare path, so tell search engines about all of them + a default. -->
{hasTranslations && locales.map((locale) => (
  <link rel="alternate" hreflang={localeTags[locale]} href={new URL(localizedPath(locale, path), siteUrl)} />
))}
{hasTranslations && (
  <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', path), siteUrl)} />
)}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Trading Yantra" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
