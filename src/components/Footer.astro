---
import Logo from './Logo.astro';
import { localizedPath } from '../i18n/url';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const year = new Date().getFullYear();

// Anchor ids on /product, in the same order as t.footer.productLinks.
const productAnchors = ['evidence', 'backtest', 'risk-list', 'ai-signals', 'indicators', 'candlestick', 'patterns'];
const productLinks = productAnchors.map((id, i) => ({
  href: localizedPath(lang, `/product#${id}`),
  label: t.footer.productLinks[i],
}));

const companyLinks = [
  { href: '/about', label: t.footer.aboutLink },
  { href: '/product', label: t.footer.productLink },
  { href: '/contact', label: t.footer.contactLink },
];

// Legal pages stay English-only for now (see plan) — always link to the
// English versions no matter which locale the footer itself is rendered in.
const legalLinks = [
  { href: localizedPath('en', '/disclaimer'), label: t.footer.disclaimerLink },
  { href: localizedPath('en', '/privacy-policy'), label: t.footer.privacyLink },
  { href: localizedPath('en', '/terms'), label: t.footer.termsLink },
];
---

<footer class="border-t border-line bg-ink-soft pb-24 lg:pb-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-xs text-base leading-relaxed text-fg-soft">
          {t.footer.description}
        </p>
        <a
          href="mailto:aitradingyantra@gmail.com"
          class="mt-4 inline-block text-sm font-semibold text-accent hover:text-accent-strong"
        >
          aitradingyantra@gmail.com
        </a>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-subtle">{t.footer.productHeading}</h3>
        <ul class="mt-4 space-y-3">
          {productLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-fg-soft hover:text-fg transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-subtle">{t.footer.companyHeading}</h3>
        <ul class="mt-4 space-y-3">
          {companyLinks.map((link) => (
            <li><a href={localizedPath(lang, link.href)} class="text-sm text-fg-soft hover:text-fg transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-subtle">{t.footer.legalHeading}</h3>
        <ul class="mt-4 space-y-3">
          {legalLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-fg-soft hover:text-fg transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-xl border border-line-soft bg-surface/60 p-4 text-sm leading-relaxed text-muted">
      <strong class="text-fg-soft">{t.footer.disclaimerBoxLabel}</strong> {t.footer.disclaimerBoxBody}{' '}
      <a href={localizedPath('en', '/disclaimer')} class="underline hover:text-fg-soft">{t.footer.disclaimerBoxLinkText}</a>.
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-line-soft pt-8 text-center sm:flex-row sm:text-left">
      <p class="text-xs text-subtle">© {year} Trading Yantra. {t.footer.rights}</p>
      <p class="text-xs text-subtle">{t.footer.madeFor} 🇮🇳</p>
      <p class="text-xs text-subtle">
        {t.footer.credit}{' '}
        <a
          href="https://tradingaisoftware.com/"
          target="_blank"
          rel="noopener"
          class="font-bold text-fg-soft underline-offset-2 transition-colors hover:text-accent hover:underline"
        >tradingaisoftware.com</a>
      </p>
    </div>
  </div>
</footer>
