---
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  icon: 'brain' | 'chart' | 'candlestick' | 'shield' | 'bell' | 'chart-pattern';
  href?: string;
  class?: string;
}

const { title, description, icon, href, class: className = '' } = Astro.props;
const resolvedHref = href ? withBase(href) : undefined;

const icons: Record<string, string> = {
  brain: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
  chart: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
  candlestick: 'M8 3v3m0 12v3m8-18v3m0 12v3M6 6h4v7H6V6zm8 5h4v7h-4v-7z',
  shield: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  bell: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0',
  'chart-pattern': 'M3 3v18h18M7 14l3-6 4 4 5-9',
};
---

<div class={`group relative rounded-2xl border border-line bg-surface/60 p-6 sm:p-7 transition-all hover:border-teal-500/40 hover:bg-surface ${className}`}>
  <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-brand/10 ring-1 ring-inset ring-teal-500/30">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="h-6 w-6 text-teal-300">
      <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon]} />
    </svg>
  </div>
  <h3 class="mt-4 text-lg font-bold text-white">
    {resolvedHref ? <a href={resolvedHref} class="after:absolute after:inset-0">{title}</a> : title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-400">{description}</p>
</div>
