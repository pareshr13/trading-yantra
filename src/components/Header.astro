---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizedPath, stripLocalePrefix } from '../i18n/url';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;

const navLinks = [
  { href: '/', label: t.nav.home },
  { href: '/about', label: t.nav.about },
  { href: '/product', label: t.nav.product },
  { href: '/contact', label: t.nav.contact },
];

const barePath = stripLocalePrefix(Astro.url.pathname, lang);
// Every "Start free" button goes to a signup form: the one on this page when
// there is one (SignupForm's script scrolls to it), else the home page's.
const signupHref = localizedPath(lang, '/') + '#signup';
const isActive = (href: string) => (href === '/' ? barePath === '/' : barePath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md">
  <div class="mx-auto flex h-18 sm:h-20 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
    <a href={localizedPath(lang, '/')} class="group min-w-0 py-1" aria-label="Trading Yantra home">
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={localizedPath(lang, link.href)}
          class={`px-4 py-2 rounded-lg text-sm font-semibold tracking-wide transition-colors ${
            isActive(link.href)
              ? 'text-fg bg-fg/5'
              : 'text-fg-soft hover:text-fg hover:bg-fg/5'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <LanguageSwitcher lang={lang} path={barePath} />
      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line text-fg-soft transition-colors hover:border-accent/50 hover:text-fg"
        aria-label={t.common.themeToggle}
        title={t.common.themeToggle}
      >
        <!-- sun shows in dark theme (switch to light), moon in light theme -->
        <svg class="h-5 w-5 light:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
        <svg class="hidden h-5 w-5 light:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
      </button>
      <a
        href={signupHref}
        data-signup-link
        class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-brand px-5 py-2.5 text-sm font-bold text-on-brand shadow-lg shadow-teal-500/15 transition-transform hover:scale-[1.03]"
      >
        {t.nav.cta}
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2 lg:hidden">
      <button
        type="button"
        data-theme-toggle
        class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-line min-[440px]:inline-flex text-fg-soft transition-colors hover:border-accent/50 hover:text-fg"
        aria-label={t.common.themeToggle}
        title={t.common.themeToggle}
      >
        <!-- sun shows in dark theme (switch to light), moon in light theme -->
        <svg class="h-5 w-5 light:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
        <svg class="hidden h-5 w-5 light:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
      </button>
      <a href={signupHref} data-signup-link class="inline-flex items-center whitespace-nowrap rounded-lg bg-gradient-brand px-3 py-2 text-sm font-bold text-on-brand min-[480px]:px-3.5">{t.nav.cta}</a>
    <button
      id="mobile-menu-button"
      type="button"
      class="inline-flex shrink-0 items-center justify-center rounded-lg p-2 text-fg hover:bg-fg/5 lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-ink px-4 pb-6 pt-2">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={localizedPath(lang, link.href)}
          class={`rounded-lg px-3 py-3 text-base font-semibold ${
            isActive(link.href) ? 'text-fg bg-fg/5' : 'text-fg-soft hover:bg-fg/5 hover:text-fg'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href={signupHref}
        data-signup-link
        class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-lg bg-gradient-brand px-4 py-3 text-base font-bold text-on-brand"
      >
        {t.nav.cta}
      </a>
      <div class="mt-4 flex items-center justify-center gap-4 border-t border-line-soft pt-4">
        <LanguageSwitcher lang={lang} path={barePath} class="text-sm" />
        <button
          type="button"
          data-theme-toggle
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line text-fg-soft hover:text-fg"
          aria-label={t.common.themeToggle}
        >
          <svg class="h-5 w-5 light:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
          <svg class="hidden h-5 w-5 light:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  // Theme toggle: flips data-theme on <html> and remembers the choice.
  document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
    el.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f5f7fb' : '#05070f');
      try { localStorage.setItem('ty-theme', next); } catch {}
    });
  });

  // Close the mobile menu when a "Start free" link inside it is used.
  document.querySelectorAll('#mobile-menu a[data-signup-link]').forEach((a) =>
    a.addEventListener('click', () => document.getElementById('mobile-menu-button')?.click()));

  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!!isHidden));
  });

  // Close the mobile menu automatically when the viewport grows back to desktop.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
