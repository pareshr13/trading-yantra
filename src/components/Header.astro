---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizedPath, stripLocalePrefix } from '../i18n/url';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n/dictionaries';

interface Props {
  lang: Locale;
  t: Dictionary;
}

const { lang, t } = Astro.props;

const navLinks = [
  { href: '/', label: t.nav.home },
  { href: '/about', label: t.nav.about },
  { href: '/product', label: t.nav.product },
  { href: '/contact', label: t.nav.contact },
];

const barePath = stripLocalePrefix(Astro.url.pathname, lang);
const isActive = (href: string) => (href === '/' ? barePath === '/' : barePath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/85 backdrop-blur-md">
  <div class="mx-auto flex h-18 sm:h-20 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
    <a href={localizedPath(lang, '/')} class="group py-1" aria-label="Trading Yantra home">
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={localizedPath(lang, link.href)}
          class={`px-4 py-2 rounded-lg text-sm font-semibold tracking-wide transition-colors ${
            isActive(link.href)
              ? 'text-white bg-white/5'
              : 'text-slate-300 hover:text-white hover:bg-white/5'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <LanguageSwitcher lang={lang} path={barePath} />
      <a
        href={localizedPath(lang, '/contact')}
        class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-brand px-4 py-2 text-sm font-bold text-ink shadow-lg shadow-teal-500/10 transition-transform hover:scale-[1.03]"
      >
        {t.nav.cta}
      </a>
    </div>

    <button
      id="mobile-menu-button"
      type="button"
      class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-200 hover:bg-white/5"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-ink px-4 pb-6 pt-2">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={localizedPath(lang, link.href)}
          class={`rounded-lg px-3 py-3 text-base font-semibold ${
            isActive(link.href) ? 'text-white bg-white/5' : 'text-slate-300 hover:bg-white/5 hover:text-white'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href={localizedPath(lang, '/contact')}
        class="mt-2 inline-flex items-center justify-center gap-1.5 rounded-lg bg-gradient-brand px-4 py-3 text-base font-bold text-ink"
      >
        {t.nav.cta}
      </a>
      <div class="mt-4 flex justify-center border-t border-line-soft pt-4">
        <LanguageSwitcher lang={lang} path={barePath} class="text-sm" />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!!isHidden));
  });

  // Close the mobile menu automatically when the viewport grows back to desktop.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
