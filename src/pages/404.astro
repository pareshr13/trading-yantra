---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
import { dictionaries } from '../i18n/dictionaries';

const lang = 'en' as const;
const t = dictionaries[lang];
const title = 'Page Not Found';
const description = 'The page you’re looking for doesn’t exist.';
---

<BaseLayout title={title} description={description} lang={lang} t={t} path="/404" noindex hasTranslations={false}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-radial-fade"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
      <p class="font-mono text-sm font-bold uppercase tracking-widest text-teal-400">404</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        This chart went <span class="text-gradient-brand">off the grid.</span>
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-slate-400">
        The page you're looking for doesn't exist or may have moved. Let's get you back on trend.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/')} class="inline-flex items-center justify-center rounded-lg bg-gradient-brand px-6 py-3 text-sm font-bold text-ink transition-transform hover:scale-[1.02]">
          Back to Home
        </a>
        <a href={withBase('/product')} class="inline-flex items-center justify-center rounded-lg border border-line px-6 py-3 text-sm font-bold text-slate-200 transition-colors hover:border-teal-500/40 hover:text-white">
          Explore the Product
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
