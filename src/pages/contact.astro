---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Contact Us';
const description =
  'Get in touch with the Trading Yantra team — ask a product question, request early access, or explore a partnership.';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Trading Yantra',
};
---

<BaseLayout title={title} description={description} path="/contact" jsonLd={[contactJsonLd]}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[380px] bg-radial-fade"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
        <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
        Get in touch
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Let's talk <span class="text-gradient-brand">trading intelligence</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        Questions about the product, want early access, or exploring a partnership? Send us a
        message — a real person reads every one.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="space-y-8">
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-widest text-slate-500">Email</h2>
          <a href="mailto:hello@tradingyantra.in" class="mt-3 block text-lg font-bold text-teal-300 hover:text-teal-200">
            hello@tradingyantra.in
          </a>
          <p class="mt-2 text-sm text-slate-400">For product questions, early access & everything else.</p>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-widest text-slate-500">Response time</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">
            We're a small team — expect a reply within 1–2 business days. Early-access requests are
            reviewed and onboarded in batches.
          </p>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="text-sm font-bold uppercase tracking-widest text-slate-500">Before you write in</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">
            We can't provide personalised investment advice or comment on individual trades. For
            product support, feature requests, or partnership enquiries, we're all ears.
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
