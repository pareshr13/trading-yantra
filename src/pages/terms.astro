---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const title = 'Terms of Service';
const description = 'The terms governing your use of the Trading Yantra website and product.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <h1 class="text-4xl font-extrabold tracking-tight text-white">Terms of Service</h1>
    <p class="mt-3 text-sm text-slate-500">Last updated: September 2026</p>

    <div class="prose-invert mt-10 space-y-6 text-sm leading-relaxed text-slate-300">
      <p>
        These terms govern your use of the Trading Yantra website. By using this site, you agree
        to these terms. If you do not agree, please do not use the site.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Use of this website</h2>
      <p>
        This website is provided to share information about Trading Yantra and to let visitors
        request early access or contact our team. You agree to use it only for lawful purposes and
        not to attempt to disrupt, reverse engineer, or misuse the site or its contact form.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">No investment advice</h2>
      <p>
        Content on this site — including feature descriptions, statistics, and illustrative
        product previews — is provided for general information only and does not constitute
        investment advice. See our
        <a href={withBase('/disclaimer')} class="text-teal-300 underline hover:text-teal-200">Risk Disclaimer</a>
        for full detail.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Intellectual property</h2>
      <p>
        The Trading Yantra name, logo, and the content of this website are the property of Trading
        Yantra unless otherwise noted. You may not reproduce, distribute, or create derivative
        works from this site's content without our written permission.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Illustrative content</h2>
      <p>
        Some dashboard previews, numbers, and examples shown on this site are illustrative
        mock-ups of product functionality rather than live or historical trading data, and are
        labelled as such where shown.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Limitation of liability</h2>
      <p>
        This website and its content are provided "as is" without warranties of any kind. To the
        maximum extent permitted by law, Trading Yantra is not liable for any damages arising from
        your use of, or inability to use, this website.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Governing law</h2>
      <p>
        These terms are governed by the laws of India, without regard to conflict-of-law
        principles.
      </p>

      <h2 class="pt-4 text-lg font-bold text-white">Changes</h2>
      <p>
        We may update these terms from time to time. Continued use of the site after changes are
        posted constitutes acceptance of the updated terms.
      </p>

      <p class="pt-4 text-slate-400">
        Questions about these terms? Email
        <a href="mailto:aitradingyantra@gmail.com" class="text-teal-300 underline hover:text-teal-200">aitradingyantra@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
