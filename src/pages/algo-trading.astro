---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { dictionaries } from '../i18n/dictionaries';
import { buildSoftwareJsonLd } from '../i18n/jsonld';

const lang = 'en' as const;
const t = dictionaries[lang];

const title = 'Algo Trading for NSE & BSE — Coming Soon';
const description =
  'Automated algo trading is coming to Trading Yantra — planned direct integration with Zerodha, Upstox, Angel One, Fyers and Dhan, so AI signals can place trades with limits you control. Join the waitlist.';

const platforms = ['Zerodha', 'Upstox', 'Angel One', 'Fyers', 'Dhan'];

const faqs = [
  {
    q: 'Will Trading Yantra ever ask for my broker password?',
    a: 'No. Broker connections are planned to use each broker’s official, secure login (OAuth-style, the same method broker-authorised apps already use) — Trading Yantra would never see or store your password.',
  },
  {
    q: 'Which brokers will be supported first?',
    a: 'We’re planning for Zerodha, Upstox, Angel One, Fyers and Dhan — five of the most widely used trading platforms in India. Exact order and timing depend on each broker’s API access and approval process.',
  },
  {
    q: 'Will every AI signal trade automatically?',
    a: 'No — the plan is opt-in per signal, with your own limits: a maximum trade size, a daily loss cap, and the choice to require manual approval before anything is placed. You stay in control of what, if anything, executes automatically.',
  },
  {
    q: 'Is algo trading legal in India?',
    a: 'Algorithmic trading for retail investors is permitted in India but sits under exchange and broker rules that continue to evolve (SEBI has been tightening retail algo trading requirements). We’ll follow whatever framework applies at launch — this page will be updated as the feature gets closer to release.',
  },
  {
    q: 'When will this launch?',
    a: 'There’s no fixed date yet — broker API integrations take real engineering and approval time. Join the waitlist on this page and we’ll email you the moment it’s ready to try.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  t={t}
  path="/algo-trading"
  hasTranslations={false}
  jsonLd={[buildSoftwareJsonLd(description), faqJsonLd]}
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-radial-fade"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24 lg:px-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-950 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide text-amber-300">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        Coming Soon
      </span>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Signals that can place the trade <span class="text-gradient-brand">for you.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        We’re building direct, secure connections to India’s most-used trading platforms — so
        a Trading Yantra signal doesn’t just tell you what to do, it can place the order, with
        limits you set.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Planned platforms</h2>
      <p class="mt-4 text-lg text-slate-300">
        We’re starting with the trading platforms most Indian retail traders already use.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {platforms.map((broker) => (
        <span class="rounded-xl border border-line bg-surface px-5 py-3 text-base font-bold text-white">{broker}</span>
      ))}
    </div>
    <p class="mx-auto mt-6 max-w-xl text-center text-sm text-slate-400">
      Subject to each broker’s API access and approval process — the platform list may change
      before launch.
    </p>
  </section>

  <section class="border-y border-line bg-ink-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">How it’s planned to work</h2>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3">
        {[
          { step: '01', title: 'Connect your broker', body: 'A secure, official login flow — the same kind broker-authorised apps already use. Trading Yantra never sees your broker password.' },
          { step: '02', title: 'Choose which signals trade', body: 'Turn on auto-trade only for the signals you trust. Nothing executes automatically unless you switch it on.' },
          { step: '03', title: 'Set your own limits', body: 'A maximum trade size, a daily loss cap, and an option to require your manual approval before anything is placed.' },
        ].map((s) => (
          <div class="relative">
            <span class="font-mono text-5xl font-black text-white/10">{s.step}</span>
            <h3 class="mt-2 text-xl font-bold text-white">{s.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-slate-300">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">You stay in control</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">
      Automated execution is a bigger responsibility than a signal on a screen — we’re treating it
      that way. Every planned safeguard (limits, opt-in per signal, manual-approval mode) exists
      because we’d rather you trust the system slowly than lose money to a setting you didn’t know
      was on.
    </p>
    <p class="mx-auto mt-4 max-w-xl text-sm text-slate-400">
      Algo trading carries real financial risk, same as manual trading — automation doesn’t remove
      it. Please read our <a href="/disclaimer" class="text-teal-300 underline hover:text-teal-200">risk disclaimer</a> before this
      feature launches.
    </p>
  </section>

  <section class="border-t border-line bg-ink-soft">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Questions people ask us</h2>
      <div class="mt-12 space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-line bg-surface px-5 py-4 open:border-teal-500/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-bold text-white">
              {f.q}
              <svg class="h-5 w-5 flex-none text-slate-400 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-slate-300">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Get notified when it’s ready</h2>
      <p class="mt-4 text-lg text-slate-300">
        Leave your details and we’ll email you the moment algo trading opens for early access —
        no spam, just the one message.
      </p>
    </div>
    <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <ContactForm lang={lang} t={t} />
    </div>
  </section>
</BaseLayout>
