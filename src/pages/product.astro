---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const title = 'Product — AI Signals, Indicators & Candlestick Intelligence';
const description =
  'Explore Trading Yantra’s AI/ML signals, technical indicator engine, candlestick & price-action intelligence, chart-pattern research and risk-aware regime filter for NSE & BSE swing trading.';

const faqs = [
  {
    q: 'Is Trading Yantra a registered investment adviser?',
    a: 'No. Trading Yantra is a technology and analytics product for informational and educational purposes only. It is not a SEBI-registered investment adviser, and nothing in the product is personalised investment advice. Please read our risk disclaimer before making any trading decision.',
  },
  {
    q: 'Which markets does Trading Yantra cover?',
    a: 'Trading Yantra is built for NSE and BSE listed equities, using daily OHLC price data.',
  },
  {
    q: 'What actually generates a signal?',
    a: 'Three layers working together: a technical indicator engine (RSI, EMA, ADX, ATR, Bollinger Bands, Williams %R), a candlestick and price-action engine (12 pattern detectors scored against market context), and AI/ML models trained on historical price action.',
  },
  {
    q: 'Do you really publish results that don’t work?',
    a: 'Yes. Our research engine benchmarks every pattern and rule against an unconditional baseline, and when a popular setup underperforms that baseline, that finding is documented rather than hidden. It is the core design principle behind the product.',
  },
  {
    q: 'How is risk handled?',
    a: 'A market-regime check can shrink or veto suggested position sizing in confirmed downtrends, instead of treating every signal as equally safe to act on regardless of the broader market.',
  },
  {
    q: 'How do I get access?',
    a: 'Trading Yantra is currently onboarding early-access users. Head to the Contact page and tell us a bit about how you trade — we’ll follow up with next steps.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Trading Yantra',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description,
  offers: { '@type': 'Offer', availability: 'https://schema.org/PreOrder' },
};

const sections = [
  {
    id: 'ai-signals',
    eyebrow: 'AI & Machine Learning',
    title: 'Model-driven signals, trained on real price history',
    body: "AI/ML models trained on historical NSE & BSE price action surface buy/sell signals alongside the rule-based engines — a second, independent read on the same stock, so you're not relying on a single method.",
    bullets: [
      'Trained on historical daily OHLC data across NSE & BSE symbols',
      'Model output is one input among several, not a black-box final word',
      'Designed to complement, not replace, the technical and candlestick engines',
    ],
    metric: { label: 'Signal type', value: 'AI / ML' },
  },
  {
    id: 'indicators',
    eyebrow: 'Technical Indicator Engine',
    title: 'The six indicators serious swing traders already trust',
    body: 'RSI, EMA, ADX, ATR, Bollinger Bands and Williams %R are computed daily across your watchlist and distilled into buy, sell, strong-buy and strong-sell signals — no spreadsheet required.',
    bullets: [
      'RSI, EMA & ADX for momentum and trend strength',
      'ATR & Bollinger Bands for volatility context',
      'Williams %R to flag overbought / oversold extremes',
    ],
    metric: { label: 'Indicators', value: '6+' },
  },
  {
    id: 'candlestick',
    eyebrow: 'Candlestick & Price-Action Intelligence',
    title: 'Twelve candlestick patterns, read in context — not isolation',
    body: 'A point-in-time context engine evaluates trend, pullback state, support/resistance, volume, relative strength and volatility alongside each candlestick pattern, so a hammer at the top of an exhausted rally isn’t treated the same as one at a tested support level.',
    bullets: [
      '12 hand-verified candlestick detectors',
      'Context engine: trend, S/R, volume, relative strength, volatility, regime',
      'Every pattern benchmarked against an unconditional baseline',
    ],
    metric: { label: 'Detectors', value: '12' },
  },
  {
    id: 'patterns',
    eyebrow: 'Chart Pattern Research',
    title: 'We measure breakouts honestly — wins and losses',
    body: 'Triangles, flags and head-and-shoulders breakouts are backtested, not assumed. When our research shows a popular breakout pattern underperforms a random baseline, that result ships in the product’s own documentation instead of being quietly dropped.',
    bullets: [
      'Every chart pattern is benchmarked, not just charted',
      'Negative findings are published, not filtered out',
      'A risk-aware regime filter can veto position size in confirmed downtrends',
    ],
    metric: { label: 'Philosophy', value: 'Evidence-first' },
  },
];
---

<BaseLayout title={title} description={description} path="/product" jsonLd={[softwareJsonLd, faqJsonLd]}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-radial-fade"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24 lg:px-8">
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
        <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
        The Product
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Every screen answers one question: <span class="text-gradient-brand">what does the evidence say?</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
        Four engines, one dashboard — AI/ML models, a technical indicator scanner, candlestick &amp;
        price-action intelligence, and honestly-measured chart pattern research.
      </p>
    </div>
  </section>

  {sections.map((s, i) => (
    <section id={s.id} class={`border-b border-line ${i % 2 === 1 ? 'bg-ink-soft' : ''}`}>
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class={`grid grid-cols-1 items-center gap-12 lg:grid-cols-2 ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-teal-400">{s.eyebrow}</p>
            <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{s.title}</h2>
            <p class="mt-5 text-base leading-relaxed text-slate-400">{s.body}</p>
            <ul class="mt-6 space-y-3">
              {s.bullets.map((b) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 h-5 w-5 flex-none text-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm text-slate-300">{b}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-line bg-surface p-8">
            <div class="flex items-center justify-between border-b border-line-soft pb-4">
              <span class="font-mono text-xs uppercase tracking-widest text-slate-500">{s.metric.label}</span>
              <span class="rounded-full bg-white/5 px-2.5 py-1 font-mono text-xs text-teal-300">Live engine</span>
            </div>
            <p class="mt-6 font-mono text-5xl font-extrabold text-gradient-brand">{s.metric.value}</p>
            <div class="mt-8 space-y-3">
              {[70, 45, 85].map((w) => (
                <div class="h-2.5 w-full overflow-hidden rounded-full bg-white/5">
                  <div class="h-full rounded-full bg-gradient-brand" style={`width:${w}%`}></div>
                </div>
              ))}
            </div>
            <p class="mt-6 text-xs text-slate-500">Illustrative dashboard preview.</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Watchlist & alerts -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-teal-400">Watchlist &amp; Live Alerts</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Know when your watchlist moves</h2>
        <p class="mt-5 text-base leading-relaxed text-slate-400">
          Track the stocks you care about and get notified when a buy, sell or take-profit
          opportunity is detected — so you're not manually refreshing charts during market hours.
        </p>
      </div>
      <div class="space-y-3">
        {[
          { tag: 'BUY', symbol: 'HDFCBANK', note: 'RSI crossed above 30 with rising volume.' },
          { tag: 'TAKE_PROFIT', symbol: 'TCS', note: 'Price approaching upper Bollinger Band.' },
          { tag: 'SELL', symbol: 'ZOMATO', note: 'Bearish engulfing confirmed at resistance.' },
        ].map((a) => (
          <div class="flex items-center justify-between rounded-xl border border-line bg-surface px-4 py-3.5">
            <div class="flex items-center gap-3">
              <span class={`rounded px-2 py-1 text-[10px] font-extrabold uppercase ${
                a.tag === 'BUY' ? 'bg-emerald-950 text-emerald-300' : a.tag === 'SELL' ? 'bg-rose-950 text-rose-300' : 'bg-amber-950 text-amber-300'
              }`}>{a.tag}</span>
              <span class="font-mono text-sm font-bold text-white">{a.symbol}</span>
            </div>
            <span class="hidden text-xs text-slate-500 sm:block">{a.note}</span>
          </div>
        ))}
        <p class="pt-1 text-xs text-slate-500">Illustrative examples, not live or historical trade data.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line bg-ink-soft">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-12 space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-line bg-surface px-5 py-4 open:border-teal-500/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-bold text-white">
              {f.q}
              <svg class="h-5 w-5 flex-none text-slate-500 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Ready to trade on evidence?"
    description="Get early access to the full Trading Yantra dashboard — AI/ML signals, indicators, and candlestick intelligence in one place."
  />
</BaseLayout>
