---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionaries } from '../i18n/dictionaries';

const lang = 'en' as const;
const t = dictionaries[lang];
const title = 'Privacy Policy';
const description = 'How Trading Yantra collects, uses, and protects the information you share with us.';
---

<BaseLayout title={title} description={description} lang={lang} t={t} path="/privacy-policy" hasTranslations={false}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <h1 class="text-4xl font-extrabold tracking-tight text-fg">Privacy Policy</h1>
    <p class="mt-3 text-sm text-subtle">Last updated: November 2026</p>

    <div class="prose-invert mt-10 space-y-6 text-sm leading-relaxed text-fg-soft">
      <p>
        This policy explains what information Trading Yantra collects through this website and how
        it is used. It applies to this marketing website; the Trading Yantra product itself will
        have its own, more detailed privacy policy once available.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Information you provide</h2>
      <p>
        When you submit the contact form, we collect the name, email address, phone number (if
        provided), and message content you enter. This is used solely to respond to your enquiry
        and, if you request it, to follow up about early access to the product. We do not sell this
        information.
      </p>

      <p>
        When you sign up for early access, we collect your full name, mobile number and email
        address. We use them to set up your account and to contact you about it by phone call,
        WhatsApp or email. We do not sell this information or share it for anyone else's marketing.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Form processing</h2>
      <p>
        Contact form and signup submissions are relayed via a third-party form service (Web3Forms) that
        delivers the message to our inbox. That provider processes the submitted fields solely to
        deliver the message and does not appear as a separate tracker on this site.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Cookies & analytics</h2>
      <p>
        With your permission, this website uses Google Analytics 4 to understand how it is used:
        which pages are visited and when, how visitors arrive (for example from a search engine or
        a shared link), their approximate location (country and city, worked out from the IP
        address, which Google Analytics does not store), and the type of device and browser. When
        a signup or contact form is sent successfully, we also record that it happened, without
        your name, phone number, email or message. We use this only to improve the website.
      </p>
      <p>
        Google Analytics sets cookies (named <code>_ga</code> and <code>_ga_&lt;id&gt;</code>) to
        tell visits apart. They are set only after you click <strong>Accept</strong> on the cookie
        banner; if you click <strong>Decline</strong>, the Google Analytics script is not loaded at
        all. You can change your choice at any time with the <strong>Cookie settings</strong> link
        in the footer, and withdrawing consent removes those cookies. Google processes this data on
        our behalf and may process it outside India. Analytics data is kept for no longer than the
        retention period set in our Google Analytics account, at most 14 months. We do not use
        advertising cookies or share analytics data for advertising.
      </p>
      <p>
        Fonts are loaded from Google Fonts, which may log standard request metadata (such as IP
        address) as part of serving the font files; no Trading Yantra account or profile data is
        attached to that request.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Data retention</h2>
      <p>
        Contact form and signup submissions are retained only as long as needed to respond to you and
        for reasonable record-keeping, after which they may be deleted.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Your rights</h2>
      <p>
        You can ask us to access, correct, or delete any personal information you've submitted to
        us by emailing
        <a href="mailto:aitradingyantra@gmail.com" class="text-accent underline hover:text-accent-strong">aitradingyantra@gmail.com</a>.
        We will respond within a reasonable time.
      </p>

      <h2 class="pt-4 text-lg font-bold text-fg">Changes to this policy</h2>
      <p>
        We may update this policy as the product evolves. Material changes will be reflected by
        updating the "Last updated" date above.
      </p>

      <p class="pt-4 text-muted">
        Questions? Contact us at
        <a href="mailto:aitradingyantra@gmail.com" class="text-accent underline hover:text-accent-strong">aitradingyantra@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
