---
import BaseLayout from '../layouts/BaseLayout.astro';
import CandlestickHero from '../components/CandlestickHero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatCounter from '../components/StatCounter.astro';
import CtaBanner from '../components/CtaBanner.astro';

const title = 'AI Stock Analysis & Swing Trading Signals for NSE & BSE';
const description =
  'Trading Yantra combines AI/ML models, technical indicators, and candlestick pattern intelligence to help retail traders analyse NSE & BSE stocks — with every signal backed by measured, published results.';
---

<BaseLayout title={title} description={description} path="/">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-radial-fade"></div>
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:px-8 lg:py-28">
      <div>
        <p class="fade-in-up inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-teal-300">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
          Built for NSE &amp; BSE swing traders
        </p>
        <h1 class="fade-in-up mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]" style="animation-delay:0.05s">
          Stock analysis that shows its <span class="text-gradient-brand">work</span>, not just its wins.
        </h1>
        <p class="fade-in-up mt-6 max-w-xl text-lg leading-relaxed text-slate-400" style="animation-delay:0.1s">
          Trading Yantra fuses AI/ML models, classic technical indicators, and candlestick &amp;
          chart-pattern intelligence into one clear signal — and we publish what the data actually
          shows, including the patterns that <em class="text-slate-300 not-italic font-semibold">don't</em> work.
        </p>
        <div class="fade-in-up mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:0.15s">
          <a href="/contact" class="inline-flex items-center justify-center rounded-lg bg-gradient-brand px-6 py-3.5 text-sm font-bold text-ink shadow-lg shadow-teal-500/10 transition-transform hover:scale-[1.02]">
            Get Early Access
          </a>
          <a href="/product" class="inline-flex items-center justify-center rounded-lg border border-line px-6 py-3.5 text-sm font-bold text-slate-200 transition-colors hover:border-teal-500/40 hover:text-white">
            See How It Works
          </a>
        </div>
        <p class="fade-in-up mt-5 text-xs text-slate-500" style="animation-delay:0.2s">
          Educational &amp; informational tool. Not SEBI-registered investment advice. See our
          <a href="/disclaimer" class="underline hover:text-slate-300">risk disclaimer</a>.
        </p>
      </div>

      <div class="fade-in-up" style="animation-delay:0.1s">
        <CandlestickHero />
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-line bg-ink-soft">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        <div>
          <p class="font-mono text-2xl font-extrabold text-white">NSE + BSE</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-500">Exchange coverage</p>
        </div>
        <div>
          <p class="font-mono text-2xl font-extrabold text-white">12</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-500">Candlestick detectors</p>
        </div>
        <div>
          <p class="font-mono text-2xl font-extrabold text-white">6+</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-500">Technical indicators</p>
        </div>
        <div>
          <p class="font-mono text-2xl font-extrabold text-white">AI + ML</p>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-slate-500">Model-driven signals</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature highlights -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">One dashboard, four ways to read the market</h2>
      <p class="mt-4 text-base text-slate-400">
        Every screen is built around the same question: what does the evidence actually say — not
        what looks good in a demo.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <FeatureCard
        icon="brain"
        title="AI & ML Signals"
        description="Machine-learning models trained on historical NSE/BSE price action surface buy/sell signals — model outputs, not gut calls."
        href="/product#ai-signals"
      />
      <FeatureCard
        icon="chart"
        title="Technical Indicator Engine"
        description="RSI, EMA, ADX, ATR, Bollinger Bands and Williams %R computed daily across your watchlist and screened into clear signals."
        href="/product#indicators"
      />
      <FeatureCard
        icon="candlestick"
        title="Candlestick Intelligence"
        description="12 candlestick detectors plus a context engine (trend, support/resistance, volume, regime) score each pattern in context — not in isolation."
        href="/product#candlestick"
      />
      <FeatureCard
        icon="shield"
        title="Risk-Aware Regime Filter"
        description="A market-regime check can veto or shrink position sizing in confirmed downtrends, instead of firing signals blind to the broader trend."
        href="/product#patterns"
      />
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-line bg-ink-soft">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">How Trading Yantra works</h2>
        <p class="mt-4 text-base text-slate-400">From raw market data to a signal you can act on, in three steps.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3">
        {[
          {
            step: '01',
            title: 'Ingest &amp; compute',
            body: 'Daily NSE/BSE OHLC data feeds a technical-indicator and candlestick/price-action engine, plus AI/ML models trained on historical patterns.',
          },
          {
            step: '02',
            title: 'Score in context',
            body: 'Every pattern and signal is evaluated against trend, volume, support/resistance and market regime — not treated as a standalone rule.',
          },
          {
            step: '03',
            title: 'Surface a clear call',
            body: 'You get a signal with the reasoning behind it, plus a risk-aware position-size check — and access to the measured track record, good and bad.',
          },
        ].map((s) => (
          <div class="relative">
            <span class="font-mono text-5xl font-black text-white/10">{s.step}</span>
            <h3 class="mt-2 text-xl font-bold text-white" set:html={s.title} />
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Honesty / differentiation -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Most trading tools only show you the wins. <span class="text-gradient-brand">We publish the losses too.</span>
        </h2>
        <p class="mt-5 text-base leading-relaxed text-slate-400">
          Retail traders have seen enough "guaranteed profit" signal groups. Trading Yantra is built
          on the opposite idea: every pattern and rule is measured against an unconditional baseline,
          and the result — even when it says a popular setup has no edge — is what ships in the
          product.
        </p>
        <ul class="mt-8 space-y-4">
          {[
            'Chart-pattern breakouts are back-tested, and reported honestly when they don’t beat a random baseline.',
            'Candlestick signals are scored in market context, not as isolated shapes.',
            'A regime filter can shrink or veto position size in confirmed downtrends instead of firing blind.',
          ].map((point) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-none text-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm text-slate-300">{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-8">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-500">Our stats, plainly</p>
        <div class="mt-8 grid grid-cols-3 gap-6">
          <StatCounter value={12} label="Candlestick detectors" />
          <StatCounter value={6} label="Technical indicators" />
          <StatCounter value={2} label="Exchanges covered" />
        </div>
        <p class="mt-8 text-xs leading-relaxed text-slate-500">
          These are product counts, not performance promises. Past performance and backtested
          results don't guarantee future returns — see our
          <a href="/disclaimer" class="underline hover:text-slate-300">risk disclaimer</a>.
        </p>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Trade with evidence, not guesswork."
    description="Join the early access list and be first to try AI-powered, honestly-measured stock analysis for NSE & BSE."
  />
</BaseLayout>
