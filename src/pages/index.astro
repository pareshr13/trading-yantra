---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { dictionaries } from '../i18n/dictionaries';

const lang = 'en' as const;
const t = dictionaries[lang];
const title = 'AI Stock Market Analytics for NSE & BSE Traders — Simple, Honest, in Your Language';
const description = t.home.subcopy;
---

<BaseLayout title={title} description={description} lang={lang} t={t} path="/">
  <HomeContent lang={lang} t={t} />
</BaseLayout>
