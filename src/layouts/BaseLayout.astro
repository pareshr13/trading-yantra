---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';
import { stripLocalePrefix } from '../i18n/url';
import { localeTags, type Locale } from '../i18n/config';
import type { Dictionary } from '../i18n/dictionaries';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  t: Dictionary;
  /** Bare path with no locale prefix, e.g. '/', '/product'. Defaults to the
   * current URL with its locale prefix stripped, so most pages don't need
   * to pass this explicitly. */
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any>[];
  hasTranslations?: boolean;
}

const {
  title,
  description,
  lang,
  t,
  path = stripLocalePrefix(Astro.url.pathname, lang),
  image,
  noindex,
  jsonLd,
  hasTranslations = true,
} = Astro.props;

const skipToContent: Record<Locale, string> = {
  en: 'Skip to content',
  hi: 'सीधे मुख्य भाग पर जाएँ',
  mr: 'थेट मुख्य भागाकडे जा',
  gu: 'સીધા મુખ્ય ભાગ પર જાઓ',
};
---

<!doctype html>
<html lang={localeTags[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070f" />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <Seo
      title={title}
      description={description}
      lang={lang}
      path={path}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
      hasTranslations={hasTranslations}
    />
  </head>
  <body class="bg-ink text-slate-200 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-teal-400 focus:px-4 focus:py-2 focus:text-ink focus:font-bold"
    >
      {skipToContent[lang]}
    </a>
    <Header lang={lang} t={t} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} t={t} />
  </body>
</html>
